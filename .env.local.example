# Supabase (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role Key -- solo para operaciones admin en servidor, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys)
RESEND_API_KEY=
# Opcional: remitente con dominio verificado en Resend. Sin esto, se usa el
# sandbox de Resend (onboarding@resend.dev), que solo entrega a la casilla
# dueña de la cuenta.
RESEND_FROM_EMAIL=
